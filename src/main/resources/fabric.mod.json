{
  "schemaVersion": 1,
  "id": "crash-utils",
  "version": "${version}",
  "name": "Crash Utils",
  "description": "Add simple crash exploits and utils",
  "license": "Apache-2.0",
  "authors": [
    "Kredwi"
  ],
  "contact": {
    "sources": "https://github.com/Kredwi/CrashUtilsAddon",
    "issues": "https://github.com/Kredwi/CrashUtilsAddon/issues",
    "homepage": "https://kredwi.ru",
    "email": "kredwicraft@gmail.com"
  },
  "icon": "assets/crashutils/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "ru.kredwi.crashutils.CrashUtils"
    ]
  },
  "mixins": [
    "crash-utils.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}",
    "meteor-client": "*"
  }
}
